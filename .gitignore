# =============================================================================
# Environment & credentials — never commit, never push
# =============================================================================
# Backend secrets — always local-only
backend/.env
backend/.env.*

# Frontend env files: the per-environment defaults (`.env`, `.env.development`,
# `.env.production`, `.env.example`) are config (not secrets) and MUST be
# committed — that's what makes builds reproducible. Only the `.local`
# overrides are personal and gitignored.
frontend/.env.local
frontend/.env.*.local
frontend/.env.development.local
frontend/.env.production.local

# Wildcard catches stray .env files anywhere else (keep last so the explicit
# allows above win).
.env.local
*.env.local

credentials.json
*.pem
*.key
.credentials

# Test / dev secrets — keep local-only
memory/test_credentials.md
test_reports/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
*.egg-info/

# =============================================================================
# Node / React
# =============================================================================
node_modules/
build/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artefacts — but keep the published APK so it can be downloaded
# straight from the GitHub repo. To make the !exception work we have to
# ignore the *contents* of `dist/` rather than the directory itself,
# otherwise git won't recurse into it.
dist/*
!dist/payroll-debug.apk

# =============================================================================
# Android (Capacitor wrapper) — Gradle / IDE intermediates
# =============================================================================
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/local.properties
frontend/android/captures/
*.iml

# Locally-installed Android SDK + JDK we cache during APK builds — huge, never push
android-sdk/

# =============================================================================
# OS / editor
# =============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# =============================================================================
# Emergent platform internals — required locally, not part of the source repo
# =============================================================================
.emergent/
