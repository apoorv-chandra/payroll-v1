# =============================================================================
# DEVELOPMENT — local Docker Compose / Emergent preview container.
#
# CRA auto-loads this file when `yarn start` (NODE_ENV=development) is run.
# Override locally by creating `.env.development.local` (gitignored) — useful
# when you want to point your local frontend at the production Render API
# while debugging a prod-only bug.
# =============================================================================
REACT_APP_BACKEND_URL=https://pdf-editor-lite.preview.emergentagent.com
WDS_SOCKET_PORT=443
DANGEROUSLY_DISABLE_HOST_CHECK=true
