# =============================================================================
# Reference template — copy to `.env.development.local` or `.env.production.local`
# for local overrides. The committed `.env.development` and `.env.production`
# already cover normal dev + prod builds; you only need a `.local` override
# when you want to point at a different backend without touching the
# committed defaults.
#
# CRA reads in this order (later overrides earlier):
#   1. .env
#   2. .env.<NODE_ENV>            (.env.development / .env.production)
#   3. .env.local                 (gitignored)
#   4. .env.<NODE_ENV>.local      (gitignored)   ← put personal overrides here
# =============================================================================

# Public-facing URL of the FastAPI backend (no trailing slash, no /api suffix).
# CRA bakes this into the JS bundle at build time — changing it later requires
# a rebuild.
REACT_APP_BACKEND_URL=https://payroll-api-8x2w.onrender.com

# Dev-server-only (ignored by yarn build):
# WDS_SOCKET_PORT=443
# DANGEROUSLY_DISABLE_HOST_CHECK=true

# Build-time optimisations (production):
# GENERATE_SOURCEMAP=false
# INLINE_RUNTIME_CHUNK=false
