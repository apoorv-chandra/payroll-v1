# =============================================================================
# PRODUCTION — Render backend + Atlas MongoDB.
#
# CRA auto-loads this file when `yarn build` (NODE_ENV=production) is run.
# Used by:
#   • Local builds      : `cd frontend && yarn build`
#   • Mobile APK builds : `scripts/build-android-apk.sh`
#   • CI / GitHub Actions
#
# Cloudflare Pages and Render also set REACT_APP_BACKEND_URL in their
# dashboards — those values override this file when they build there.
# This file is the **source of truth for everything else** (manual local
# builds, the Android APK, any new platform).
# =============================================================================
REACT_APP_BACKEND_URL=https://payroll-api-8x2w.onrender.com

# CRA build optimisations. Source maps generate slow + leak source code;
# turning them off shrinks the bundle ~30% and silences hundreds of source-map
# warnings from third-party packages (face-api.js, etc.).
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
